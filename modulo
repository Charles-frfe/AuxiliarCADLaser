Private Sub AdicionarTexturaDetectada(nomeOriginal As String,
                                      encontradas As List(Of String),
                                      jaAdicionadas As HashSet(Of String))
    If String.IsNullOrWhiteSpace(nomeOriginal) Then Return

    Dim nome As String = ExtrairCodigoTextura(nomeOriginal)

    If nome = "" Then Return

    Dim nomeLimpo As String = ModuloFuncoes.LimparNomePasta(nome)

    If nomeLimpo = "" Then Return
    If jaAdicionadas.Contains(nomeLimpo) Then Return

    jaAdicionadas.Add(nomeLimpo)
    encontradas.Add(nome.ToUpperInvariant())
End Sub