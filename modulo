Private Function PastaNumeroTemLavPenDireto(pastaNumero As String) As Boolean
    If String.IsNullOrWhiteSpace(pastaNumero) OrElse Not Directory.Exists(pastaNumero) Then
        Return False
    End If

    Dim lav As String = Path.Combine(pastaNumero, "lav")
    Dim pen As String = Path.Combine(pastaNumero, "pen")

    Return Directory.Exists(lav) OrElse Directory.Exists(pen)
End Function

Private Function EhPastaOperacionalCN(nomePasta As String) As Boolean
    If String.IsNullOrWhiteSpace(nomePasta) Then Return False

    Dim nome As String = nomePasta.Trim().ToLowerInvariant()

    If nome = "lav" Then Return True
    If nome = "pen" Then Return True

    Return False
End Function