Private Function SelecionarModeloFichaTecnica() As String
    Dim caminhosPadrao As New List(Of String) From {
        Path.Combine(Application.StartupPath, "modelos", "Ficha_Tecnica_Laser.xlsx"),
        Path.Combine(Application.StartupPath, "modelos", "Ficha_Tecnica_Laser.xlsm")
    }

    For Each caminho As String In caminhosPadrao
        If File.Exists(caminho) Then
            Return caminho
        End If
    Next

    Using dialogo As New OpenFileDialog()
        dialogo.Title = "Selecione o modelo da Ficha Técnica"
        dialogo.Filter = "Planilhas Excel (*.xlsx;*.xlsm)|*.xlsx;*.xlsm"
        dialogo.CheckFileExists = True
        dialogo.RestoreDirectory = True

        If dialogo.ShowDialog(Me) = DialogResult.OK Then
            Return dialogo.FileName
        End If
    End Using

    Return ""
End Function