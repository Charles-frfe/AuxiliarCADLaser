    Private Sub TipoMatrizMudou(sender As Object, e As EventArgs)
        If cboTipoMatriz Is Nothing OrElse lblTexturas Is Nothing Then Return

        Dim partes As String() = ObterPartesFamilia(cboTipoMatriz.Text)
        Dim composta As Boolean = partes.Length > 1

        If composta Then
            lblTexturas.Text = "Texturas detectadas — escolha por parte na próxima tela"
            If chkTexturas IsNot Nothing Then
                LimparSelecaoTexturas()
                chkTexturas.Enabled = False
            End If
        Else
            lblTexturas.Text = "Texturas detectadas na pasta do modelo"
            If chkTexturas IsNot Nothing Then chkTexturas.Enabled = True
        End If
    End Sub

    Private Function ObterPartesFamilia(familia As String) As String()
        Select Case ModuloFuncoes.LimparNomePasta(familia)
            Case "lateral"
                Return New String() {"LFE", "LFD", "LME", "LMD"}
            Case "forma"
                Return New String() {"FE", "FD"}
            Case "fundo"
                Return New String() {"FundoD", "FundoE"}
            Case Else
                Return New String() {familia}
        End Select
    End Function

    Private Sub AtualizarListaMatrizes()
        If lstMatrizes Is Nothing Then Return

        lstMatrizes.Items.Clear()

        For i As Integer = 0 To matrizes.Count - 1

            lstMatrizes.Items.Add(MontarDescricaoMatriz(matrizes(i)))
        Next
    End Sub

    Private Function MontarDescricaoMatriz(matriz As MatrizAuxiliar) As String
        If matriz Is Nothing Then Return ""

        Dim partes As New List(Of String)()

        Dim identificacao As String = matriz.TipoMatriz

        If Not String.IsNullOrWhiteSpace(matriz.FamiliaMatriz) AndAlso
       Not String.Equals(matriz.FamiliaMatriz, matriz.TipoMatriz, StringComparison.OrdinalIgnoreCase) Then

            identificacao = matriz.FamiliaMatriz & " — " & matriz.TipoMatriz
        End If

        partes.Add("Matriz: " & identificacao)

        If cboTipoServico IsNot Nothing AndAlso
       cboTipoServico.Text.Trim().ToLower() = "escala" AndAlso
       Not String.IsNullOrWhiteSpace(matriz.TextoNumeros) Then

            partes.Add("Números: " & matriz.TextoNumeros)
        End If

        If Not String.IsNullOrWhiteSpace(matriz.TextoTexturas) Then
            partes.Add("Texturas: " & ResumoTexturasMatriz(matriz.TextoTexturas))
        End If

        If Not String.IsNullOrWhiteSpace(matriz.Maquina) Then
            partes.Add("Máquina: " & matriz.Maquina)
        End If

        If Not String.IsNullOrWhiteSpace(matriz.Material) Then
            partes.Add("Material: " & matriz.Material)
        End If

        If Not String.IsNullOrWhiteSpace(matriz.Eixos) Then
            partes.Add("Eixos: " & matriz.Eixos)
        End If

        If Not String.IsNullOrWhiteSpace(matriz.Projetista) Then
            partes.Add("Projetista: " & matriz.Projetista)
        End If

        Return String.Join(" | ", partes)
    End Function

    Private Function ResumoTexturasMatriz(textoTexturas As String) As String
        If String.IsNullOrWhiteSpace(textoTexturas) Then Return ""

        Dim texto As String = textoTexturas.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf)
        Dim linhas As String() = texto.Split(New String() {vbLf}, StringSplitOptions.RemoveEmptyEntries)

        Dim nomes As New List(Of String)()

        For Each linha As String In linhas
            Dim nome As String = linha.Trim().ToUpperInvariant()

            If nome <> "" Then
                nomes.Add(nome)
            End If
        Next

        Return String.Join(" ", nomes)
    End Function

    Private Sub GerarPastas(sender As Object, e As EventArgs)
        Try
            If matrizes.Count = 0 Then
                System.Windows.Forms.MessageBox.Show(
                    "Adicione pelo menos uma matriz antes de gerar as pastas.",
                    "Gerar Pastas CN",
                    System.Windows.Forms.MessageBoxButtons.OK,
                    System.Windows.Forms.MessageBoxIcon.Warning
                )
