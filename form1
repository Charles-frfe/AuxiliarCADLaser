Private Sub GerarFichaTecnica(sender As Object, e As EventArgs)
    Try
        If matrizes Is Nothing OrElse matrizes.Count = 0 Then
            MessageBox.Show(
                "Adicione pelo menos uma matriz antes de gerar a ficha técnica.",
                "Ficha Técnica",
                MessageBoxButtons.OK,
                MessageBoxIcon.Warning
            )
            Return
        End If

        Dim mensagens As New List(Of String)()

        mensagens.Add("FICHA TÉCNICA - TESTE")
        mensagens.Add("")
        mensagens.Add("Código: " & txtCodigo.Text.Trim())
        mensagens.Add("Nome do modelo: " & txtNomeModelo.Text.Trim())
        mensagens.Add("Tipo de serviço: " & cboTipoServico.Text.Trim())
        mensagens.Add("Componente: " & txtComponente.Text.Trim())
        mensagens.Add("")
        mensagens.Add("Matrizes adicionadas:")

        For i As Integer = 0 To matrizes.Count - 1
            mensagens.Add((i + 1).ToString() & ". " & MontarDescricaoMatriz(matrizes(i)))
        Next

        MostrarMensagens(mensagens)

        MessageBox.Show(
            "Botão Gerar Ficha Técnica funcionando." &
            Environment.NewLine &
            "Na próxima etapa vamos começar a gerar o Excel.",
            "Ficha Técnica",
            MessageBoxButtons.OK,
            MessageBoxIcon.Information
        )

    Catch ex As Exception
        MessageBox.Show(
            ex.Message,
            "Ficha Técnica",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error
        )
    End Try
End Sub