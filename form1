    Private Sub AdicionarMatriz(sender As Object, e As EventArgs)
        Dim familia As String = If(cboTipoMatriz.SelectedItem Is Nothing, "", cboTipoMatriz.SelectedItem.ToString()).Trim()

        If familia = "" Then
            System.Windows.Forms.MessageBox.Show(
            "Informe o tipo da matriz.",
            "Matriz",
            System.Windows.Forms.MessageBoxButtons.OK,
            System.Windows.Forms.MessageBoxIcon.Warning
        )
            Return
        End If

        If cboTipoServico.Text.Trim().ToLower() = "escala" AndAlso txtNumeros.Text.Trim() = "" Then
            System.Windows.Forms.MessageBox.Show(
            "Para escala, informe os números separados por vírgula.",
            "Matriz",
            System.Windows.Forms.MessageBoxButtons.OK,
            System.Windows.Forms.MessageBoxIcon.Warning
        )
            Return
        End If

        Dim partes As String() = ObterPartesFamilia(familia)

        If partes.Length > 1 Then
            Using tela As New FormPartesMatriz(familia, partes, txtNumeros.Text.Trim(), ObterTexturasDisponiveis())
                If tela.ShowDialog(Me) <> DialogResult.OK Then Return

                For Each matrizConfigurada As MatrizAuxiliar In tela.MatrizesConfiguradas
                    matrizConfigurada.Maquina = cboMaquinaMatriz.Text.Trim()
                    matrizConfigurada.Material = cboMaterialMatriz.Text.Trim()
                    matrizConfigurada.Eixos = cboEixosMatriz.Text.Trim()
                    matrizConfigurada.Projetista = txtProjetistaMatriz.Text.Trim()
                Next

                matrizes.AddRange(tela.MatrizesConfiguradas)
            End Using
        Else
            Dim tipoGerado As String = If(String.Equals(familia, "Encaixe", StringComparison.OrdinalIgnoreCase), "Gravação", partes(0))

            matrizes.Add(New MatrizAuxiliar() With {
            .FamiliaMatriz = familia,
            .TipoMatriz = tipoGerado,
            .TextoTexturas = ObterTexturasSelecionadas(),
            .TextoNumeros = txtNumeros.Text.Trim(),
            .Maquina = cboMaquinaMatriz.Text.Trim(),
            .Material = cboMaterialMatriz.Text.Trim(),
            .Eixos = cboEixosMatriz.Text.Trim(),
            .Projetista = txtProjetistaMatriz.Text.Trim()
        })
        End If

        AtualizarListaMatrizes()
        LimparCamposMatriz(Nothing, Nothing)
    End Sub

    Private Sub RemoverMatriz(sender As Object, e As EventArgs)
        If lstMatrizes.SelectedIndex < 0 Then
            Return
        End If

        Dim indice As Integer = lstMatrizes.SelectedIndex

        If indice >= 0 AndAlso indice < matrizes.Count Then
            matrizes.RemoveAt(indice)
            AtualizarListaMatrizes()
        End If
    End Sub

    Private Sub LimparCamposMatriz(sender As Object, e As EventArgs)
        LimparSelecaoTexturas()

        If txtNumeros IsNot Nothing Then
            txtNumeros.Clear()
        End If

        If cboMaquinaMatriz IsNot Nothing Then
            cboMaquinaMatriz.SelectedIndex = -1
        End If

        If cboMaterialMatriz IsNot Nothing Then
            cboMaterialMatriz.SelectedIndex = -1
        End If

        If cboEixosMatriz IsNot Nothing Then
            cboEixosMatriz.SelectedIndex = -1
        End If

        If txtProjetistaMatriz IsNot Nothing Then
            txtProjetistaMatriz.Clear()
        End If

        If cboTipoMatriz IsNot Nothing AndAlso cboTipoMatriz.Items.Count > 0 Then
            cboTipoMatriz.SelectedIndex = 0
            cboTipoMatriz.Focus()
        End If
