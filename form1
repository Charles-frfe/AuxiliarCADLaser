    Private Sub AtualizarTexturasModelo(sender As Object, e As EventArgs)
        CarregarTexturasDaPastaModelo()
    End Sub

    Private Sub CarregarTexturasDaPastaModelo()
        If chkTexturas Is Nothing Then Return

        chkTexturas.Items.Clear()

        Dim pastaModelo As String = ""

        If txtPastaModelo IsNot Nothing Then
            pastaModelo = txtPastaModelo.Text.Trim()
        End If

        If String.IsNullOrWhiteSpace(pastaModelo) OrElse Not Directory.Exists(pastaModelo) Then
            If lblTexturas IsNot Nothing Then
                lblTexturas.Text = "Texturas detectadas — selecione a pasta do modelo"
            End If

            Return
        End If

        Dim texturas As List(Of String) = DetectarTexturasDaPasta(pastaModelo)

        For Each textura As String In texturas
            chkTexturas.Items.Add(textura, False)
        Next

        If lblTexturas IsNot Nothing Then
            If texturas.Count = 0 Then
                lblTexturas.Text = "Texturas detectadas — nenhuma encontrada"
            Else
                lblTexturas.Text = "Texturas detectadas na pasta do modelo (" & texturas.Count.ToString() & ")"
            End If
        End If
    End Sub

    Private Function DetectarTexturasDaPasta(pastaModelo As String) As List(Of String)
        Dim encontradas As New List(Of String)()
        Dim jaAdicionadas As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)

        If String.IsNullOrWhiteSpace(pastaModelo) OrElse Not Directory.Exists(pastaModelo) Then
            Return encontradas
        End If

        Try
            For Each pastaTextura As String In Directory.GetDirectories(pastaModelo)
                Dim nomePasta As String = Path.GetFileName(pastaTextura)

                If EhPastaDeTextura(nomePasta) Then
                    AdicionarTexturaDetectada(nomePasta, encontradas, jaAdicionadas)
                End If
            Next
        Catch
            ' Se a pasta da rede não puder ser lida, retorna a lista vazia.
        End Try

        encontradas.Sort(StringComparer.OrdinalIgnoreCase)

        Return encontradas
    End Function

    Private Function EhPastaDeTextura(nomePasta As String) As Boolean
        If String.IsNullOrWhiteSpace(nomePasta) Then Return False

        Dim nome As String = nomePasta.Trim().ToLowerInvariant()

        If nome.StartsWith("gls_") Then Return True
        If nome.StartsWith("gl_") Then Return True
        If nome.StartsWith("gs_") Then Return True

        Return False
    End Function

    Private Sub AdicionarTexturaDetectada(nomeOriginal As String,
                                      encontradas As List(Of String),
                                      jaAdicionadas As HashSet(Of String))
        If String.IsNullOrWhiteSpace(nomeOriginal) Then Return

        Dim nome As String = nomeOriginal.Trim()
        Dim nomeLimpo As String = ModuloFuncoes.LimparNomePasta(nome)

        If nomeLimpo = "" Then Return
        If jaAdicionadas.Contains(nomeLimpo) Then Return

        jaAdicionadas.Add(nomeLimpo)
        encontradas.Add(nome.ToUpperInvariant())
    End Sub

    Private Function ObterTexturasSelecionadas() As String
        If chkTexturas Is Nothing OrElse chkTexturas.CheckedItems.Count = 0 Then Return ""

        Dim selecionadas As New List(Of String)()

        For Each item As Object In chkTexturas.CheckedItems
            If item IsNot Nothing AndAlso item.ToString().Trim() <> "" Then
                selecionadas.Add(item.ToString().Trim().ToUpperInvariant())
            End If
        Next

        Return String.Join(Environment.NewLine, selecionadas)
    End Function

    Private Function ObterTexturasDisponiveis() As List(Of String)
        Dim lista As New List(Of String)()

        If chkTexturas Is Nothing Then Return lista

        For Each item As Object In chkTexturas.Items
            If item IsNot Nothing AndAlso item.ToString().Trim() <> "" Then
                lista.Add(item.ToString().Trim().ToUpperInvariant())
            End If
        Next

        Return lista
    End Function

    Private Sub LimparSelecaoTexturas()
        If chkTexturas Is Nothing Then Return

        For i As Integer = 0 To chkTexturas.Items.Count - 1
            chkTexturas.SetItemChecked(i, False)
        Next
    End Sub

    Private Sub LimparListaTexturasDetectadas()
