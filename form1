    Private Function EncontrarBotaoPorTexto(controlePai As Control, texto As String) As Button
        If controlePai Is Nothing Then
            Return Nothing
        End If

        For Each controle As Control In controlePai.Controls
            If TypeOf controle Is Button Then
                Dim botao As Button = CType(controle, Button)

                If String.Equals(botao.Text.Trim(), texto, StringComparison.OrdinalIgnoreCase) Then
                    Return botao
                End If
            End If

            Dim encontrado As Button = EncontrarBotaoPorTexto(controle, texto)

            If encontrado IsNot Nothing Then
                Return encontrado
            End If
        Next

        Return Nothing
    End Function

    Private Sub CodigoModeloMudou(sender As Object, e As EventArgs)
        If aplicandoProjeto Then Return
        txtPastaModelo.Clear()
        txtNomeModelo.Clear()
        ultimaPastaGerada = ""
        AgendarBuscaProjeto()
    End Sub

    Private Sub AgendarBuscaProjeto()
        buscaTimer.Stop()
        versaoBusca += 1
        Dim codigo As String = txtCodigo.Text.Trim()

        If Not Regex.IsMatch(codigo, "^\d{5}$") Then
            AtualizarStatusProjeto("Digite os cinco dígitos do código para pesquisar na rede.", False)
            Return
        End If

        AtualizarStatusProjeto("Aguardando para pesquisar o projeto " & codigo & "...", False)
        buscaTimer.Start()
    End Sub

    Private Async Sub ExecutarBuscaProjeto(sender As Object, e As EventArgs)
        buscaTimer.Stop()
        Dim codigo As String = txtCodigo.Text.Trim()
        Dim versao As Integer = versaoBusca
        Dim config As ConfiguracaoAuxiliar = ModuloFuncoes.CarregarConfiguracao()

        If String.IsNullOrWhiteSpace(config.PastaProjetos) Then
            AtualizarStatusProjeto("Configure a pasta raiz dos projetos na engrenagem.", True)
            Return
        End If

        If Not Directory.Exists(config.PastaProjetos) Then
            AtualizarStatusProjeto("A pasta raiz configurada está inacessível.", True)
            Return
        End If

        AtualizarStatusProjeto("Pesquisando " & codigo & " na rede...", False)

        Try
            Dim encontrados As List(Of ProjetoEncontrado) = Await Task.Run(
                Function() LocalizadorProjetos.Localizar(codigo, config.PastaProjetos)
            )

            If versao <> versaoBusca OrElse txtCodigo.Text.Trim() <> codigo Then Return

            If encontrados.Count = 0 Then
                AtualizarStatusProjeto("Nenhuma pasta encontrada para o código " & codigo & ".", True)
                Return
            End If

            Dim escolhido As ProjetoEncontrado = Nothing
            If encontrados.Count = 1 Then
                escolhido = encontrados(0)
            Else
                Using tela As New FormSelecionarProjeto(codigo, encontrados)
                    If tela.ShowDialog(Me) = DialogResult.OK Then escolhido = tela.ProjetoSelecionado
                End Using
            End If

            If escolhido IsNot Nothing Then AplicarProjetoEncontrado(escolhido)
        Catch ex As Exception
            AtualizarStatusProjeto("Falha ao pesquisar a pasta de projetos: " & ex.Message, True)
        End Try
    End Sub

    Private Sub AplicarProjetoEncontrado(projeto As ProjetoEncontrado)
        aplicandoProjeto = True
        Try
            txtPastaModelo.Text = projeto.Caminho
            txtNomeModelo.Text = projeto.NomePasta
        Finally
            aplicandoProjeto = False
        End Try

        Dim tipoDetectado As String = ModuloFuncoes.DetectarTipoServicoPeloCaminho(projeto.Caminho)
        If tipoDetectado = "piloto" OrElse tipoDetectado = "escala" OrElse tipoDetectado = "teste" Then
            cboTipoServico.SelectedItem = tipoDetectado
        End If
        If Not String.Equals(cboTipoServico.Text, "teste", StringComparison.OrdinalIgnoreCase) Then
            cboTipoTrabalho.SelectedItem = ModuloFuncoes.DetectarTipoTrabalhoPeloCaminho(projeto.Caminho)
        End If
        AtualizarStatusProjeto("Projeto selecionado: " & projeto.NomePasta, False)

        CarregarTexturasDaPastaModelo()

        Dim abrir As DialogResult = MessageBox.Show(
            "Projeto localizado:" & Environment.NewLine & projeto.NomePasta &
            Environment.NewLine & Environment.NewLine &
            "Deseja abrir a pasta do modelo?",
            "Projeto localizado",
            MessageBoxButtons.YesNo,
            MessageBoxIcon.Question
        )
        If abrir = DialogResult.Yes Then
            Try
                ModuloFuncoes.AbrirPasta(projeto.Caminho)
            Catch ex As Exception
                MessageBox.Show(ex.Message, "Abrir pasta do modelo", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            End Try
        End If
    End Sub

    Private Sub AtualizarStatusProjeto(texto As String, erro As Boolean)
        If lblStatusProjeto Is Nothing Then Return
        lblStatusProjeto.Text = texto
        lblStatusProjeto.ForeColor = If(erro, Color.FromArgb(235, 110, 110), TemaVisual.CorTextoSuave)
    End Sub

    Private Sub SelecionarPastaModelo(sender As Object, e As EventArgs)
        Dim caminho As String = ModuloFuncoes.SelecionarPasta(
            "Selecione a pasta do modelo/projeto",
            txtPastaModelo.Text
        )

        If caminho = "" Then
            Return
        End If

        Dim nomePasta As String = ModuloFuncoes.ObterNomePastaModelo(caminho)

        If nomePasta = "" Then
            System.Windows.Forms.MessageBox.Show(
                "Não foi possível identificar a pasta selecionada.",
                "Selecionar pasta",
                System.Windows.Forms.MessageBoxButtons.OK,
                System.Windows.Forms.MessageBoxIcon.Warning
            )
            Return
        End If

        txtPastaModelo.Text = caminho
        txtNomeModelo.Text = nomePasta
        txtCodigo.Text = ExtrairCodigoModelo(nomePasta)

