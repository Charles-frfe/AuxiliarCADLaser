    Private Function SelecionarMatrizesParaNumerosCharmilles(pastasNumerosEscolhidas As List(Of String)) As List(Of String)
        Dim origens As New List(Of String)()

        If pastasNumerosEscolhidas Is Nothing OrElse pastasNumerosEscolhidas.Count = 0 Then
            Return origens
        End If

        Dim matrizesComuns As HashSet(Of String) = Nothing

        For Each pastaNumero As String In pastasNumerosEscolhidas
            If Not Directory.Exists(pastaNumero) Then
                Throw New DirectoryNotFoundException("A pasta do número não foi encontrada: " & pastaNumero)
            End If

            Dim matrizesDoNumero As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            For Each pastaMatriz As String In Directory.GetDirectories(pastaNumero)
                matrizesDoNumero.Add(New DirectoryInfo(pastaMatriz).Name)
            Next

            If matrizesComuns Is Nothing Then
                matrizesComuns = matrizesDoNumero
            Else
                matrizesComuns.IntersectWith(matrizesDoNumero)
            End If
        Next

        Dim opcoes As New List(Of OpcaoEscolhaAuxiliar) From {
            New OpcaoEscolhaAuxiliar() With {
                .Texto = "Enviar os números completos, com todas as matrizes",
                .Valor = "__TODAS__"
            }
        }

        If matrizesComuns IsNot Nothing Then
            Dim nomesMatrizes As New List(Of String)(matrizesComuns)
            nomesMatrizes.Sort(StringComparer.OrdinalIgnoreCase)
            For Each nomeMatriz As String In nomesMatrizes
                opcoes.Add(New OpcaoEscolhaAuxiliar() With {
                    .Texto = "Enviar somente a matriz " & nomeMatriz & " de todos os números selecionados",
                    .Valor = nomeMatriz
                })
            Next
        End If

        Dim valorEscolhido As String = ""
        Using tela As New FormEscolherOpcao(
            "Conteúdo para o Charmilles",
            "Escolha o que será validado e enviado para os números selecionados:",
            opcoes)

            If tela.ShowDialog(Me) = DialogResult.OK Then
                valorEscolhido = tela.ValorSelecionado
            End If
        End Using

        If valorEscolhido = "" Then
            Return origens
        End If

        If valorEscolhido = "__TODAS__" Then
            For Each pastaNumero As String In pastasNumerosEscolhidas
                Dim pastasMatrizesDoNumero As New List(Of String)(Directory.GetDirectories(pastaNumero))
                pastasMatrizesDoNumero.Sort(StringComparer.OrdinalIgnoreCase)

                If pastasMatrizesDoNumero.Count = 0 Then
                    origens.Add(pastaNumero)
                Else
                    For Each pastaMatriz As String In pastasMatrizesDoNumero
                        origens.Add(pastaMatriz)
                    Next
                End If
            Next

            Return origens
        End If

        For Each pastaNumero As String In pastasNumerosEscolhidas
            Dim pastaMatriz As String = Path.Combine(pastaNumero, valorEscolhido)

            If Directory.Exists(pastaMatriz) Then
                origens.Add(pastaMatriz)
            Else
                Throw New Exception(
                    "A matriz """ & valorEscolhido & """ não foi encontrada no número:" &
                    Environment.NewLine & pastaNumero)
            End If
        Next

        Return origens
    End Function

    Private Async Sub FinalizarProjeto(sender As Object, e As EventArgs)
        Dim botao As Button = TryCast(sender, Button)
        If botao IsNot Nothing Then botao.Enabled = False

        Dim origem As String = txtPastaModelo.Text.Trim()
        Try
            If origem = "" OrElse Not Directory.Exists(origem) Then
                Throw New Exception("Localize uma pasta de projeto em andamento antes de finalizar.")
            End If

            Dim destino As String = ModuloFuncoes.ObterDestinoFinalizados(origem)
            Dim confirmacao As DialogResult = MessageBox.Show(
                "A pasta será removida de Projetos em andamento e movida para Finalizados." &
                Environment.NewLine & Environment.NewLine &
                "Origem:" & Environment.NewLine & origem & Environment.NewLine & Environment.NewLine &
                "Destino:" & Environment.NewLine & destino & Environment.NewLine & Environment.NewLine &
                "Deseja continuar?",
                "Finalizar projeto",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning
            )
            If confirmacao <> DialogResult.Yes Then Return

            MostrarMensagens(New List(Of String) From {
                "Verificando arquivos abertos antes da finalização...",
                origem
            })

            Dim bloqueados As List(Of String) = Await Task.Run(
                Function() ModuloFuncoes.LocalizarArquivosBloqueados(origem)
            )
            If bloqueados.Count > 0 Then
                Dim mensagens As New List(Of String) From {
                    "FINALIZAÇÃO BLOQUEADA",
                    "Feche os programas que estão utilizando os arquivos abaixo:"
                }
                mensagens.AddRange(bloqueados)
                MostrarMensagens(mensagens)

                MessageBox.Show(
                    "O projeto não foi movido." & Environment.NewLine &
                    "O arquivo específico que está impedindo a operação aparece no painel de resultados.",
                    "Arquivo em uso",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                )
                Return
            End If

            MostrarMensagens(New List(Of String) From {
                "Nenhum arquivo aberto foi encontrado.",
                "Movendo o projeto para Finalizados...",
                "Origem: " & origem,
                "Destino: " & destino
            })

            Dim resultado As ResultadoFinalizacao = Await Task.Run(
                Function() ModuloFuncoes.MoverPastaParaFinalizados(origem, destino)
            )

            txtPastaModelo.Text = resultado.PastaDestino
            txtNomeModelo.Text = New DirectoryInfo(resultado.PastaDestino).Name
            AtualizarStatusProjeto("Projeto finalizado: " & txtNomeModelo.Text, False)

            MostrarMensagens(New List(Of String) From {
                "PROJETO FINALIZADO",
                "Arquivos movidos: " & resultado.QuantidadeArquivos.ToString(),
                If(resultado.CopiaEntreVolumes,
                   "A pasta foi copiada, conferida e removida da origem.",
                   "A pasta foi movida diretamente."),
                "Destino: " & resultado.PastaDestino
            })
            MessageBox.Show(
                "Projeto movido para Finalizados com sucesso.",
                "Finalizar projeto",
                MessageBoxButtons.OK,
                MessageBoxIcon.Information
            )
        Catch ex As Exception
            Dim detalhes As New List(Of String) From {
                "NÃO FOI POSSÍVEL FINALIZAR O PROJETO",
                ex.Message
            }

            If origem <> "" AndAlso Directory.Exists(origem) Then
                Dim bloqueados As List(Of String) = ModuloFuncoes.LocalizarArquivosBloqueados(origem)
                If bloqueados.Count > 0 Then
                    detalhes.Add("Arquivos que podem estar impedindo a movimentação:")
                    detalhes.AddRange(bloqueados)
                End If
            End If
            MostrarMensagens(detalhes)
            MessageBox.Show(
                ex.Message & Environment.NewLine & Environment.NewLine &
                "Consulte o painel de resultados para identificar o arquivo ou caminho responsável.",
                "Finalizar projeto",
                MessageBoxButtons.OK,
                MessageBoxIcon.Error
            )
        Finally
            If botao IsNot Nothing Then botao.Enabled = True
        End Try
    End Sub

