    Private Async Sub EnviarParaCharmilles(sender As Object, e As EventArgs)
        Dim botao As Button = TryCast(sender, Button)
        If botao IsNot Nothing Then botao.Enabled = False

        Try
            Dim origem As String = ultimaPastaGerada
            If origem = "" AndAlso txtNomeModelo.Text.Trim() <> "" Then
                origem = ModuloFuncoes.ObterPastaModeloCN(
                    txtNomeModelo.Text.Trim(), cboTipoServico.Text, cboTipoTrabalho.Text)
            End If

            If String.IsNullOrWhiteSpace(origem) OrElse Not Directory.Exists(origem) Then
                Throw New Exception("Gere ou localize a pasta CN do modelo antes de enviar ao Laser Charmilles.")
            End If

            Dim origensEnvio As List(Of String) = SelecionarOrigensCharmilles(origem)
            If origensEnvio Is Nothing OrElse origensEnvio.Count = 0 Then Return

            Dim mensagensValidacao As New List(Of String) From {
    "Validando arquivos Simulator em LAV/PEN...",
    ""
}

            For Each origemItem As String In origensEnvio
                mensagensValidacao.Add("A validar: " & ObterNomeCurtoOrigemCharmilles(origemItem))
            Next

            MostrarMensagens(mensagensValidacao)

            Dim origensOk As New List(Of String)()
            Dim checklist As New List(Of String) From {
    "CHECKLIST CHARMILLES",
    ""
}

            Dim temPendencia As Boolean = False

            For Each origemItem As String In origensEnvio
                Dim problemasItem As List(Of String) = Await Task.Run(
        Function() ModuloFuncoes.ValidarSimulatorParaEnvio(origemItem)
    )

                If problemasItem.Count = 0 Then
                    origensOk.Add(origemItem)
                    checklist.Add("[OK] " & ObterNomeCurtoOrigemCharmilles(origemItem))
                Else
                    temPendencia = True
                    checklist.Add("[PENDENTE] " & ObterNomeCurtoOrigemCharmilles(origemItem))

                    For Each problema As String In problemasItem
                        checklist.Add("   - " & problema)
                    Next

                    checklist.Add("")
                End If
            Next

            MostrarMensagens(checklist)

            If temPendencia Then
                If origensOk.Count = 0 Then
                    MessageBox.Show(
            "Nenhum item está pronto para enviar ao Laser Charmilles." & Environment.NewLine &
            "Confira no painel as pendências de Simulator em LAV/PEN.",
            "Envio bloqueado",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning
        )
                    Return
                End If

                Dim respostaPendencias As DialogResult = MessageBox.Show(
        "Foram encontradas pendências em alguns itens." & Environment.NewLine &
        "Deseja enviar somente os itens marcados como OK?",
        "Laser Charmilles",
        MessageBoxButtons.YesNo,
        MessageBoxIcon.Question
    )

                If respostaPendencias <> DialogResult.Yes Then
                    Return
                End If

                origensEnvio = origensOk
            End If

            Dim jaExistentesResumo As New List(Of String)()
            Dim novosResumo As New List(Of String)()

            For Each origemItem As String In origensEnvio

                Dim destinoItem As String = ModuloFuncoes.ObterDestinoCharmilles(origemItem)

                Dim existentes As List(Of String) =
        ModuloFuncoes.ListarItensJaExistentesNoDestino(origemItem, destinoItem)

                Dim novos As List(Of String) =
        ModuloFuncoes.ListarArquivosNovosParaDestino(origemItem, destinoItem)

                Dim nomeOrigem As String = ObterNomeCurtoOrigemCharmilles(origemItem)

                If existentes.Count > 0 Then
                    jaExistentesResumo.Add(nomeOrigem)

                    For Each item As String In existentes
                        If item.StartsWith("Arquivo: ", StringComparison.OrdinalIgnoreCase) Then
                            jaExistentesResumo.Add("   " & item)
                        End If
                    Next
                End If

                If novos.Count > 0 Then
                    novosResumo.Add(nomeOrigem)

                    For Each item As String In novos
                        novosResumo.Add("   Arquivo: " & item)
                    Next
                End If
            Next

            Dim resumoEnvio As New List(Of String)()

            resumoEnvio.Add("RESUMO DO ENVIO PARA CHARMILLES")
            resumoEnvio.Add("")

            If jaExistentesResumo.Count > 0 Then
                resumoEnvio.Add("JÁ EXISTE NO CHARMILLES:")
                resumoEnvio.AddRange(jaExistentesResumo)
                resumoEnvio.Add("")
            Else
                resumoEnvio.Add("Nenhum dos arquivos selecionados já existe no Charmilles.")
                resumoEnvio.Add("")
            End If

            If novosResumo.Count > 0 Then
                resumoEnvio.Add("SERÁ COPIADO:")
                resumoEnvio.AddRange(novosResumo)
            Else
                resumoEnvio.Add("Não há arquivos novos para copiar.")
            End If

            MostrarMensagens(resumoEnvio)

            If novosResumo.Count = 0 Then
                MessageBox.Show("Todos os arquivos selecionados já existem no Laser Charmilles." & Environment.NewLine & "Nenhum arquivo será copiado.",
"Laser Charmilles",
MessageBoxButtons.OK,
                MessageBoxIcon.Information)
                Return
            End If

            Dim todosExistentes As New List(Of String)()

            For Each origemItem As String In origensEnvio
                Dim destinoItem As String = ModuloFuncoes.ObterDestinoCharmilles(origemItem)
                Dim existentesItem As List(Of String) = ModuloFuncoes.ListarItensJaExistentesNoDestino(origemItem, destinoItem)

                If Directory.Exists(destinoItem) Then
                    todosExistentes.Add("Destino já existe: " & destinoItem)
                End If

                If existentesItem.Count > 0 Then
                    todosExistentes.Add("Itens já existentes em: " & destinoItem)
                    todosExistentes.AddRange(existentesItem)
                    todosExistentes.Add("")
                End If
            Next

            If todosExistentes.Count > 0 Then
                Dim mensagensExistentes As New List(Of String) From {
"ATENÇÃO: já existem itens no Laser Charmilles.",
"O programa vai copiar somente o que ainda não existe.",
""
}

                mensagensExistentes.AddRange(todosExistentes)
                MostrarMensagens(mensagensExistentes)

                Dim resposta As DialogResult = MessageBox.Show(
"Já existem itens no destino do Laser Charmilles." & Environment.NewLine &
"Deseja copiar somente o que ainda não existe?",
"Laser Charmilles",
MessageBoxButtons.YesNo,
MessageBoxIcon.Question
)

                If resposta <> DialogResult.Yes Then
                    Return
                End If
            End If

            Dim mensagensCopia As New List(Of String) From {
"Validação LAV/PEN concluída.",
"Copiando para Laser Charmilles...",
""
}

            Dim confirmarEnvio As DialogResult =
                MessageBox.Show(
                "Confira no painel o que já existe e o que será copiado." &
                Environment.NewLine & Environment.NewLine &
            "Deseja continuar o envio?",
            "Confirmar envio para Charmilles",
            MessageBoxButtons.YesNo,
            MessageBoxIcon.Question)

            If confirmarEnvio <> DialogResult.Yes Then
                Return
            End If

            For Each origemItem As String In origensEnvio
                mensagensCopia.Add("Origem: " & origemItem)
                mensagensCopia.Add("Destino: " & ModuloFuncoes.ObterDestinoCharmilles(origemItem))
                mensagensCopia.Add("")
            Next

            MostrarMensagens(mensagensCopia)

            Dim totalCopiados As Integer = 0
            Dim totalIgnorados As Integer = 0
            Dim itensIgnorados As New List(Of String)()

            For Each origemItem As String In origensEnvio
                Dim destinoItem As String = ModuloFuncoes.ObterDestinoCharmilles(origemItem)

                Dim resultadoCopia As ResultadoCopiaCharmilles = Await Task.Run(
Function() ModuloFuncoes.CopiarPastaParaCharmillesSemSobrescrever(origemItem, destinoItem)
)

                totalCopiados += resultadoCopia.ArquivosCopiados
                totalIgnorados += resultadoCopia.ArquivosIgnorados

                If resultadoCopia.ItensJaExistentes.Count > 0 Then
                    itensIgnorados.Add("Destino: " & destinoItem)
                    itensIgnorados.AddRange(resultadoCopia.ItensJaExistentes)
                    itensIgnorados.Add("")
                End If
            Next

            Dim mensagensFinal As New List(Of String) From {
"ENVIO CONCLUÍDO",
"Arquivos copiados: " & totalCopiados.ToString(),
"Arquivos ignorados porque já existiam: " & totalIgnorados.ToString()
}

            If itensIgnorados.Count > 0 Then
                mensagensFinal.Add("")
                mensagensFinal.Add("Itens que já existiam e não foram sobrescritos:")
                mensagensFinal.AddRange(itensIgnorados)
            End If

            MostrarMensagens(mensagensFinal)

            MessageBox.Show(
"Envio para Laser Charmilles concluído." & Environment.NewLine &
"Copiados: " & totalCopiados.ToString() & Environment.NewLine &
"Ignorados: " & totalIgnorados.ToString(),
"Laser Charmilles",
MessageBoxButtons.OK,
MessageBoxIcon.Information
)

        Catch ex As Exception
            MessageBox.Show(ex.Message, "Laser Charmilles", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Finally
            If botao IsNot Nothing Then botao.Enabled = True
        End Try
    End Sub

    Private Function ObterNomeCurtoOrigemCharmilles(caminho As String) As String
        If String.IsNullOrWhiteSpace(caminho) Then
            Return ""
        End If

        Try
            Dim raizCN As String =
                Path.GetFullPath(ModuloFuncoes.ObterPastaCN()).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
            Dim caminhoCompleto As String = Path.GetFullPath(caminho).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)

            Dim prefixo As String = raizCN &
                Path.DirectorySeparatorChar

            If caminhoCompleto.StartsWith(prefixo, StringComparison.OrdinalIgnoreCase) Then
                Return caminhoCompleto.Substring(prefixo.Length)
            End If

            Return caminhoCompleto
        Catch
            Return caminho

        End Try

    End Function


    Private Function SelecionarOrigensCharmilles(pastaModeloCN As String) As List(Of String)
        Dim origens As New List(Of String)()

        If Not String.Equals(cboTipoServico.Text.Trim(), "escala", StringComparison.OrdinalIgnoreCase) Then
            origens.Add(pastaModeloCN)
            Return origens
        End If

        Dim componente As String = ModuloFuncoes.LimparNomePasta(txtComponente.Text)

        If componente = "" Then
            Throw New Exception("Informe o componente antes de enviar a escala.")
        End If

        Dim pastaComponente As String = Path.Combine(pastaModeloCN, componente)

        If Not Directory.Exists(pastaComponente) Then
            Throw New Exception("A pasta do componente não foi encontrada no CN:" & Environment.NewLine & pastaComponente)
        End If

        Dim pastasNumeros As New List(Of String)(Directory.GetDirectories(pastaComponente))
        pastasNumeros.Sort(StringComparer.OrdinalIgnoreCase)

        If pastasNumeros.Count = 0 Then
            Throw New Exception("Nenhum número de escala foi encontrado em:" & Environment.NewLine & pastaComponente)
        End If

        Dim numerosEscolhidos As List(Of String) = SelecionarNumerosEscalaCharmilles(pastasNumeros)

        If numerosEscolhidos Is Nothing OrElse numerosEscolhidos.Count = 0 Then
            Return origens
        End If

        Return SelecionarMatrizesParaNumerosCharmilles(numerosEscolhidos)
    End Function

