Private Sub CriarTela()
        Me.Controls.Clear()

        Me.Text = "Auxiliar CAD/LASER"
        Me.StartPosition = FormStartPosition.CenterScreen
        Me.AutoScroll = True
        Me.AutoScrollMinSize = New Size(1220, 750)
        Me.MinimumSize = New Size(900, 600)

        Dim areaDisponivel As Rectangle = Screen.FromControl(Me).WorkingArea
        Dim larguraInicial As Integer = Math.Min(1240, Math.Max(900, areaDisponivel.Width - 30))
        Dim alturaInicial As Integer = Math.Min(780, Math.Max(600, areaDisponivel.Height - 30))
        Me.Size = New Size(larguraInicial, alturaInicial)

        Dim lblTitulo As New Label()
        lblTitulo.Text = "Auxiliar CAD/LASER"
        lblTitulo.Font = New Font("Segoe UI", 24, FontStyle.Bold)
        lblTitulo.Location = New Point(30, 18)
        lblTitulo.AutoSize = True
        Me.Controls.Add(lblTitulo)

        Dim lblSub As New Label()
        lblSub.Text = "1. Selecione o projeto   •   2. Confira os dados   •   3. Adicione as matrizes   •   4. Gere e confira"
        lblSub.Font = New Font("Segoe UI", 10, FontStyle.Regular)
        lblSub.ForeColor = TemaVisual.CorTextoSuave
        lblSub.Tag = "suave"
        lblSub.Location = New Point(34, 64)
        lblSub.AutoSize = True
        Me.Controls.Add(lblSub)

        Dim painelPasta As New Panel()
        painelPasta.Location = New Point(30, 95)
        painelPasta.Size = New Size(1160, 80)
        painelPasta.BorderStyle = BorderStyle.None
        Me.Controls.Add(painelPasta)

        CriarSelecaoPasta(painelPasta)

        Dim painelDados As New Panel()
        painelDados.Location = New Point(30, 190)
        painelDados.Size = New Size(340, 455)
        painelDados.BorderStyle = BorderStyle.None
        Me.Controls.Add(painelDados)

        Dim painelMatriz As New Panel()
        painelMatriz.Location = New Point(385, 190)
        painelMatriz.Size = New Size(395, 455)
        painelMatriz.BorderStyle = BorderStyle.None
        painelMatriz.AutoScroll = True
        painelMatriz.AutoScrollMinSize = New Size(0, 650)
        Me.Controls.Add(painelMatriz)

        Dim painelResultado As New Panel()
        painelResultado.Location = New Point(795, 190)
        painelResultado.Size = New Size(395, 455)
        painelResultado.BorderStyle = BorderStyle.None
        Me.Controls.Add(painelResultado)

        CriarDadosRapidos(painelDados)
        CriarAreaMatrizes(painelMatriz)
        CriarResultado(painelResultado)
        CriarBotoes()

        buscaTimer.Interval = 600
        AddHandler buscaTimer.Tick, AddressOf ExecutarBuscaProjeto

        TemaVisual.AplicarTema(Me)
        CriarBotaoTema()
        AtualizarVisibilidadeNumeros()


    End Sub
