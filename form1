    Private Function ExtrairCodigoModelo(nomePasta As String) As String
        If String.IsNullOrWhiteSpace(nomePasta) Then
            Return ""
        End If

        If nomePasta.Length >= 5 Then
            Return nomePasta.Substring(0, 5)
        End If

        Return nomePasta
    End Function

