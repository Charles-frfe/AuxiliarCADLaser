    Private Sub CriarBotaoTema()
        If btnTema IsNot Nothing Then
            Try
                If btnTema.Parent IsNot Nothing Then
                    btnTema.Parent.Controls.Remove(btnTema)
                End If

                btnTema.Dispose()
            Catch
            End Try
        End If

        btnTema = New Button()
        btnTema.Name = "btnTema"
        btnTema.Size = New Size(120, 34)
        btnTema.FlatStyle = FlatStyle.Flat

        AtualizarTextoBotaoTema()

        AddHandler btnTema.Click, AddressOf AlternarTemaPrograma

        Dim btnSairEncontrado As Button = EncontrarBotaoPorTexto(Me, "Sair")

        If btnSairEncontrado IsNot Nothing AndAlso btnSairEncontrado.Parent IsNot Nothing Then
            Dim painelDestino As Control = btnSairEncontrado.Parent

            btnTema.Location = New Point(btnSairEncontrado.Left, btnSairEncontrado.Bottom + 8)
            btnTema.Width = btnSairEncontrado.Width
            painelDestino.Controls.Add(btnTema)
        Else
            btnTema.Location = New Point(10, Me.ClientSize.Height - btnTema.Height - 10)
            btnTema.Anchor = AnchorStyles.Left Or AnchorStyles.Bottom
            Me.Controls.Add(btnTema)
        End If

        TemaVisual.AplicarTema(btnTema)
        btnTema.BringToFront()
    End Sub

    Private Sub AtualizarTextoBotaoTema()
        If btnTema Is Nothing Then
            Return
        End If

        If TemaVisual.ObterTemaAtual() = "claro" Then
            btnTema.Text = "Tema:Claro"
        Else
            btnTema.Text = "Tema:Escuro"
        End If
    End Sub
