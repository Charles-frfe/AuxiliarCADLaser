    Private Sub PrepararEmail(sender As Object, e As EventArgs)
        Try
            If cboAcabamento Is Nothing OrElse cboAcabamento.Text.Trim() = "" Then
                MessageBox.Show(
                    "Selecione o acabamento: Fosco ou Polido.",
                    "Rascunho de e-mail",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                )

                If cboAcabamento IsNot Nothing Then
                    cboAcabamento.Focus()
                End If

                Return
            End If

            EmailAuxiliar.AbrirRascunho(
                txtCodigo.Text,
                txtNomeModelo.Text,
                txtComponente.Text,
                ObterPartesMatrizEmail(),
                cboAcabamento.Text,
                txtObservacaoAcabamento.Text
            )
        Catch ex As Exception
            System.Windows.Forms.MessageBox.Show(
                "Não foi possível abrir uma nova mensagem no Outlook." &
                Environment.NewLine & Environment.NewLine & ex.Message,
                "Rascunho de e-mail",
                System.Windows.Forms.MessageBoxButtons.OK,
                System.Windows.Forms.MessageBoxIcon.Error
            )
        End Try
    End Sub

    Private Function ObterPartesMatrizEmail() As String
        Dim partes As New List(Of String)()

        For Each matriz As MatrizAuxiliar In matrizes
            If matriz Is Nothing Then
                Continue For
            End If

            Dim parte As String = matriz.TipoMatriz.Trim()
            If parte = "" Then
                Continue For
            End If

            Dim jaExiste As Boolean = partes.Exists(
                Function(item As String)
                    Return String.Equals(item, parte, StringComparison.OrdinalIgnoreCase)
                End Function
            )

            If Not jaExiste Then
                partes.Add(parte)
            End If
        Next

        Return String.Join(", ", partes.ToArray())
    End Function

