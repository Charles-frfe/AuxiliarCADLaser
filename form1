Private Function ExtrairCodigoTextura(nomePasta As String) As String
    If String.IsNullOrWhiteSpace(nomePasta) Then Return ""

    Dim nome As String = nomePasta.Trim()
    Dim nomeMin As String = nome.ToLowerInvariant()

    Dim prefixos As String() = {"gls_", "gl_", "gs_"}

    For Each prefixo As String In prefixos
        If nomeMin.StartsWith(prefixo) Then
            Dim fim As Integer = prefixo.Length

            While fim < nome.Length AndAlso Char.IsDigit(nome(fim))
                fim += 1
            End While

            If fim > prefixo.Length Then
                Return nome.Substring(0, fim).ToUpperInvariant()
            End If
        End If
    Next

    Return nome.ToUpperInvariant()
End Function